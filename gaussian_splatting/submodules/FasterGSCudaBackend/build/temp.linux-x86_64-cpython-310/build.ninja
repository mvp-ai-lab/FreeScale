ninja_required_version = 1.3
cxx = c++
nvcc = /home/yuchen/cuda-12.4/bin/nvcc

cflags = -pthread -B /home/yuchen/miniforge3/envs/doge/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/yuchen/miniforge3/envs/doge/include -fPIC -O2 -isystem /home/yuchen/miniforge3/envs/doge/include -fPIC -I/mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/utils -I/mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/adam/include -I/mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/adam -I/mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend -I/home/yuchen/miniforge3/envs/doge/lib/python3.10/site-packages/torch/include -I/home/yuchen/miniforge3/envs/doge/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/yuchen/miniforge3/envs/doge/lib/python3.10/site-packages/torch/include/TH -I/home/yuchen/miniforge3/envs/doge/lib/python3.10/site-packages/torch/include/THC -I/home/yuchen/cuda-12.4/include -I/home/yuchen/miniforge3/envs/doge/include/python3.10 -c
post_cflags = -std=c++17 -O3 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0
cuda_cflags = -I/mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/utils -I/mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/adam/include -I/mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/adam -I/mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend -I/home/yuchen/miniforge3/envs/doge/lib/python3.10/site-packages/torch/include -I/home/yuchen/miniforge3/envs/doge/lib/python3.10/site-packages/torch/include/torch/csrc/api/include -I/home/yuchen/miniforge3/envs/doge/lib/python3.10/site-packages/torch/include/TH -I/home/yuchen/miniforge3/envs/doge/lib/python3.10/site-packages/torch/include/THC -I/home/yuchen/cuda-12.4/include -I/home/yuchen/miniforge3/envs/doge/include/python3.10 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -std=c++17 -O3 -use_fast_math -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_90,code=compute_90 -gencode=arch=compute_90,code=sm_90
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





build /mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/build/temp.linux-x86_64-cpython-310/mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/adam/src/adam.o: cuda_compile /mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/adam/src/adam.cu
build /mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/build/temp.linux-x86_64-cpython-310/mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/torch_bindings/bindings.o: compile /mnt/data_4/yuchen/Projects/freescale/gaussian_splatting/submodules/FasterGSCudaBackend/torch_bindings/bindings.cpp






